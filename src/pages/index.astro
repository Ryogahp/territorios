---
import '../styles/global.css';
import { TERRITORIOS } from '../lib/territorios';

const PERSONAS = [
  "Jose Luis Huanca Cruz",
  "Alex Smith",
  "Andres Tarqui",
  "Enrique Callisaya",
  "Fernando Figueredo",
  "Franklin Salas",
  "Jherson Zegarra",
  "Jose Alvares",
  "Jose Luis Van Geendertailen",
  "Manuel Villegas",
  "Marco Sanchez",
  "Marcos Fernadez",
  "Mauricio Mendez",
  "Mike Mamani",
  "Oscar Callizaya",
  "Ramiro Narvaes",
  "Victor Villegas",
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Territorios</title>
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <div id="app" class="mx-auto max-w-[1200px] md:p-4">
      <header class="rounded-none border-b border-line bg-gradient-to-br from-white to-[#e7eff5] text-stone shadow-sm md:mb-6 md:rounded-xl md:shadow-md dark:border-transparent dark:from-stone dark:to-stone-dark dark:text-white">
        <div class="flex items-center justify-between gap-3 px-4 pt-4 md:px-6">
          <h1 class="text-lg font-semibold tracking-tight md:text-2xl">Registro de Territorios Visitados</h1>
          <div class="flex items-center gap-1">
            <button id="themeBtn" type="button" aria-label="Cambiar tema"
              class="cursor-pointer rounded-lg p-1.5 text-stone transition hover:bg-stone/10 dark:text-white/90 dark:hover:bg-white/10">
              <svg id="iconMoon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
              </svg>
              <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="hidden h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
              </svg>
            </button>
            <button id="menuBtn" type="button" aria-label="Abrir menú"
              class="cursor-pointer rounded-lg px-2 py-1 text-2xl leading-none text-stone transition hover:bg-stone/10 md:hidden dark:text-white/90 dark:hover:bg-white/10">
              &#9776;
            </button>
          </div>
        </div>
        <nav class="nav-desktop hidden flex-wrap gap-1 px-3 pt-3 pb-3 md:flex">
          <button class="tab active rounded-lg text-stone/70 hover:bg-stone/10 hover:text-stone dark:text-white/75 dark:hover:bg-white/10 dark:hover:text-white" data-tab="registro">
            Registro
          </button>
          <button class="tab rounded-lg text-stone/70 hover:bg-stone/10 hover:text-stone dark:text-white/75 dark:hover:bg-white/10 dark:hover:text-white" data-tab="pendientes">
            Lista de territorios por visitar
          </button>
          <button class="tab rounded-lg text-stone/70 hover:bg-stone/10 hover:text-stone dark:text-white/75 dark:hover:bg-white/10 dark:hover:text-white" data-tab="asignaciones">
            S-13_S
          </button>
          <button class="tab rounded-lg text-stone/70 hover:bg-stone/10 hover:text-stone dark:text-white/75 dark:hover:bg-white/10 dark:hover:text-white" data-tab="control">
            Control de salidas
          </button>
        </nav>
      </header>

      <div id="mobileMenu" class="fixed inset-0 z-50 hidden md:hidden">
        <div id="menuOverlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
        <nav id="menuSidebar" class="nav-mobile absolute top-0 left-0 flex h-full w-72 max-w-[85vw] -translate-x-full flex-col gap-1 overflow-y-auto bg-surface p-4 text-ink shadow-2xl transition-transform duration-300 dark:bg-stone dark:text-white">
          <p class="px-2 pt-1 pb-2 text-xs font-medium tracking-wide text-ink-subtle uppercase dark:text-white/50">Menú</p>
          <button class="tab active w-full rounded-lg text-left text-ink-muted hover:bg-stone/10 hover:text-stone dark:text-white/85 dark:hover:bg-white/10 dark:hover:text-white" data-tab="registro">
            Registro
          </button>
          <button class="tab w-full rounded-lg text-left text-ink-muted hover:bg-stone/10 hover:text-stone dark:text-white/85 dark:hover:bg-white/10 dark:hover:text-white" data-tab="pendientes">
            Lista de territorios por visitar
          </button>
          <button class="tab w-full rounded-lg text-left text-ink-muted hover:bg-stone/10 hover:text-stone dark:text-white/85 dark:hover:bg-white/10 dark:hover:text-white" data-tab="asignaciones">
            S-13_S
          </button>
          <button class="tab w-full rounded-lg text-left text-ink-muted hover:bg-stone/10 hover:text-stone dark:text-white/85 dark:hover:bg-white/10 dark:hover:text-white" data-tab="control">
            Control de salidas
          </button>
        </nav>
      </div>

      <main class="flex flex-col gap-3 md:gap-6">
        <section id="contentRegistro">
          <div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-3 md:gap-6">
            <aside id="asideForm" class="card h-fit p-4 md:p-6">
              <h2 class="section-title">
                Registrar visita
              </h2>
              <form id="visitaForm" class="flex flex-col gap-4">
                <label class="field-label">
                  Fecha
                  <input type="date" id="fecha" required class="input" />
                </label>
                <label class="field-label">
                  Persona
                  <input type="text" id="persona" required list="listaPersonas" placeholder="Escribe o elige una persona"
                    class="input" />
                  <datalist id="listaPersonas">
                    {PERSONAS.map((p) => (
                      <option value={p}></option>
                    ))}
                  </datalist>
                </label>
                <label class="field-label">
                  Turno
                  <select id="turno" required class="input">
                    <option value="">Elige el turno</option>
                    <option value="Mañana">Mañana</option>
                    <option value="Tarde">Tarde</option>
                  </select>
                </label>
                <label class="field-label">
                  Cantidad de personas que salieron
                  <input type="number" id="cantidadPersonas" min="1" placeholder="Ej. 2" class="input" />
                </label>
                <label class="field-label">
                  Territorio
                  <select id="territorio" required class="input">
                    <option value="">Selecciona un territorio</option>
                    {TERRITORIOS.map((t) => (
                      <option value={t.numero}>Territorio {t.numero} — {t.letras.length} cuadras</option>
                    ))}
                  </select>
                </label>
                <label class="field-label">
                  Cuadras visitadas
                  <div id="cuadrasCheckboxes" class="grid grid-cols-2 gap-2 rounded-lg border border-mist/50 bg-surface-2 p-2 sm:grid-cols-3 lg:grid-cols-4"></div>
                </label>
                <button type="submit" id="submitBtn" class="btn-primary w-full">
                  Guardar visita
                </button>
                <button type="button" id="cancelEditBtn" class="btn-danger hidden w-full">
                  Cancelar edición
                </button>
                <button type="button" id="addTerritorioBtn" class="btn-dashed w-full">
                  + Agregar otro territorio (máx. 3)
                </button>
              </form>
              <p id="formMessage" class="mt-4 text-sm font-medium"></p>
            </aside>

            <div class="card p-4 md:p-6">
              <h2 class="section-title">
                Historial de visitas
              </h2>
              <p id="statusMessage" class="font-medium mb-4 text-sm"></p>
              <div id="tablaContainer" class="overflow-x-auto"></div>
            </div>
          </div>
        </section>

        <section id="contentPendientes" class="card hidden p-4 md:p-6">
          <h2 class="section-title">
            Territorios por visitar
          </h2>
          <div id="territoriosList" class="grid grid-cols-1 items-start content-start gap-3 md:grid-cols-2 2xl:grid-cols-3"></div>
        </section>

        <section id="contentControl" class="card hidden p-4 md:p-6">
          <h2 class="section-title">
            Control de salidas diarias
          </h2>
          <div class="mb-4">
            <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-surface-2 px-3 py-2 text-sm font-medium ring-1 ring-mist/50 transition hover:bg-surface-3">
              <input type="checkbox" id="soloSinSalida" class="h-4 w-4 cursor-pointer accent-stone" />
              Mostrar solo días sin salida registrada
            </label>
          </div>
          <div id="resumenControl" class="mb-3 flex flex-wrap gap-2"></div>
          <div id="controlContainer" class="flex flex-col gap-3"></div>
        </section>
      </main>

      <section id="contentAsignaciones" class="relative left-1/2 hidden w-screen -translate-x-1/2 px-0 pb-4 md:px-4 md:pb-8">
        <div class="card p-3 md:p-4">
          <h2 class="section-title">
            Plan de asignación de territorios
          </h2>
          <div class="mb-4 flex flex-wrap items-end gap-3">
            <label class="field-label">
              Mes de inicio
              <input type="month" id="mesInicio" class="input" />
            </label>
            <label class="field-label">
              Mes de fin
              <input type="month" id="mesFin" class="input" />
            </label>
            <p class="max-w-md text-xs text-ink-muted">La tabla muestra las visitas de los meses seleccionados (mínimo 4 columnas). "Última vez predicado" muestra la última visita anterior al mes de inicio.</p>
          </div>
          <div id="tablaAsignaciones" class="overflow-x-auto"></div>
        </div>
      </section>
    </div>

    <div id="territoriosData" data-territorios={JSON.stringify(TERRITORIOS)} hidden></div>

    <script is:inline>
      // Elementos del DOM
      const form = document.getElementById('visitaForm');
      const fechaInput = document.getElementById('fecha');
      const personaInput = document.getElementById('persona');
      const turnoInput = document.getElementById('turno');
      const cantidadInput = document.getElementById('cantidadPersonas');
      const territorioSelect = document.getElementById('territorio');
      const cuadrasCheckboxes = document.getElementById('cuadrasCheckboxes');
      const addTerritorioBtn = document.getElementById('addTerritorioBtn');
      const submitBtn = document.getElementById('submitBtn');
      const cancelEditBtn = document.getElementById('cancelEditBtn');
      const formMessage = document.getElementById('formMessage');
      const statusMessage = document.getElementById('statusMessage');
      const tablaContainer = document.getElementById('tablaContainer');
      const territoriosList = document.getElementById('territoriosList');

      // Datos locales de territorios (espejo del frontmatter)
      const TERRITORIOS = JSON.parse(document.getElementById('territoriosData').dataset.territorios);
      const territoriosLetras = Object.fromEntries(TERRITORIOS.map((t) => [t.numero, t.letras]));

      // Estado global: visitas cargadas y contador de filas de territorio en el form
      let visitas = [];
      let filasTerritorio = 1;
      let editandoId = null;

      // ---- Pestañas: muestra el contenido de la pestaña activa ----
      const tabs = document.querySelectorAll('.tab');
      const mainEl = document.querySelector('main');
      const contentAsignaciones = document.getElementById('contentAsignaciones');
      const tabContents = {
        registro: document.getElementById('contentRegistro'),
        pendientes: document.getElementById('contentPendientes'),
        control: document.getElementById('contentControl'),
      };

      tabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabs.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          if (btn.dataset.tab === 'asignaciones') {
            mainEl.classList.add('hidden');
            contentAsignaciones.classList.remove('hidden');
          } else {
            mainEl.classList.remove('hidden');
            contentAsignaciones.classList.add('hidden');
            Object.values(tabContents).forEach((c) => c.classList.add('hidden'));
            tabContents[btn.dataset.tab].classList.remove('hidden');
          }
          cerrarMenu();
        });
      });

      // ---- Menú hamburguesa (móvil): abre/cierra el panel lateral ----
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      const menuOverlay = document.getElementById('menuOverlay');
      const menuSidebar = document.getElementById('menuSidebar');
      function abrirMenu() {
        mobileMenu.classList.remove('hidden');
        requestAnimationFrame(() => menuSidebar.classList.remove('-translate-x-full'));
      }
      function cerrarMenu() {
        menuSidebar.classList.add('-translate-x-full');
        setTimeout(() => mobileMenu.classList.add('hidden'), 300);
      }
      menuBtn.addEventListener('click', abrirMenu);
      menuOverlay.addEventListener('click', cerrarMenu);

      // ---- Formato de fecha a dd/mm/aaaa para mostrar en la tabla ----
      function formatearFecha(iso) {
        const f = new Date(iso + 'T00:00:00');
        const d = String(f.getDate()).padStart(2, '0');
        const m = String(f.getMonth() + 1).padStart(2, '0');
        return d + '/' + m + '/' + f.getFullYear();
      }

      // ---- Convierte cuadras (array o cadena "A,C-E,H") a una lista de letras ----
      function expandirCuadras(cuadras) {
        if (Array.isArray(cuadras)) return cuadras.map((l) => String(l).toUpperCase());
        if (!cuadras) return [];
        const lista = [];
        String(cuadras).split(',').forEach((parte) => {
          const m = parte.trim().match(/^([A-Za-z])(?:-([A-Za-z]))?$/);
          if (!m) return;
          let c = m[1].toUpperCase().charCodeAt(0);
          const fin = m[2] ? m[2].toUpperCase().charCodeAt(0) : c;
          for (; c <= fin; c++) lista.push(String.fromCharCode(c));
        });
        return lista;
      }

      // ---- Ordena y elimina duplicados de una lista de letras ----
      function ordenarUnicas(lista) {
        return [...new Set(lista.map((l) => String(l).toUpperCase()))].sort();
      }

      // ---- Cuántos días pasaron desde una fecha ISO hasta hoy ----
      function calcularDias(iso) {
        const fecha = new Date(iso + 'T00:00:00');
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);
        return Math.round((hoy - fecha) / 86400000);
      }

      // ---- Muestra un mensaje en el form (error en rojo / éxito en verde) ----
      function setFormMessage(msg, tipo) {
        formMessage.textContent = msg;
        formMessage.classList.remove('text-autumn', 'dark:text-red-300', 'text-green-700', 'dark:text-green-400');
        if (tipo === 'error') {
          formMessage.classList.add('text-autumn', 'dark:text-red-300');
        } else {
          formMessage.classList.add('text-green-700', 'dark:text-green-400');
        }
      }

      // ---- Genera los checkboxes de cuadras para una fila de territorio ----
      function renderCuadras() {
        cuadrasCheckboxes.innerHTML = '';
        const numero = parseInt(territorioSelect.value, 10);
        const letras = territoriosLetras[numero];
        if (!letras) return;

        const contador = document.createElement('div');
        contador.className = 'col-span-full mb-1 text-xs font-medium text-ink-muted';
        contador.id = 'contadorSeleccion';
        contador.textContent = '0 seleccionadas de ' + letras.length;
        cuadrasCheckboxes.appendChild(contador);

        letras.forEach((letra) => {
          const label = document.createElement('label');
          label.className = 'cb-label flex items-center gap-1.5 text-sm cursor-pointer rounded-md border border-mist/60 bg-surface px-2 py-1 transition-colors hover:bg-mist/10 has-checked:border-stone has-checked:bg-stone/10';
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.value = letra;
          checkbox.className = 'cb-checkbox cursor-pointer';
          label.appendChild(checkbox);
          label.appendChild(document.createTextNode(letra));
          cuadrasCheckboxes.appendChild(label);
        });

        const contadorSeleccion = document.getElementById('contadorSeleccion');
        cuadrasCheckboxes.querySelectorAll('.cb-checkbox').forEach((cb) => {
          cb.addEventListener('change', () => {
            const seleccionadas = cuadrasCheckboxes.querySelectorAll('.cb-checkbox:checked').length;
            contadorSeleccion.textContent = seleccionadas + ' seleccionadas de ' + letras.length;
          });
        });
      }

      // ---- Crea una fila de territorio adicional en el form (máx. 3) ----
      function createTerritorioRow() {
        const row = document.createElement('div');
        row.className = 'territorio-row rounded-lg bg-surface-2 p-3 ring-1 ring-mist/50';

        const header = document.createElement('div');
        header.className = 'row-header flex justify-between items-center mb-2';
        const label = document.createElement('span');
        label.className = 'row-label font-medium text-sm';
        label.textContent = 'Territorio ' + filasTerritorio;
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'remove-row bg-transparent border-none text-autumn cursor-pointer text-sm font-semibold hover:underline';
        removeBtn.textContent = '✕ Eliminar';
        header.appendChild(label);
        header.appendChild(removeBtn);
        row.appendChild(header);

        const select = document.createElement('select');
        select.className = 'territorio-select input mb-2';
        select.innerHTML = territorioSelect.innerHTML;
        select.value = '';
        row.appendChild(select);

        const cbs = document.createElement('div');
        cbs.className = 'cuadras-checkboxes grid grid-cols-2 gap-2 rounded-lg border border-mist/50 bg-surface p-2 sm:grid-cols-3 lg:grid-cols-4';
        row.appendChild(cbs);

        const hint = document.createElement('p');
        hint.className = 'select-hint mt-2 text-xs text-ink-muted';
        hint.textContent = 'Selecciona un territorio para ver sus cuadras.';
        row.appendChild(hint);

        return row;
      }

      // ---- Pinta los checkboxes de cuadras de la fila seleccionada ----
      function renderCuadrasFila(row, letras) {
        const cbs = row.querySelector('.cuadras-checkboxes');
        const hint = row.querySelector('.select-hint');
        cbs.innerHTML = '';
        hint.textContent = '';

        if (!letras) {
          hint.textContent = 'Selecciona un territorio para ver sus cuadras.';
          return;
        }

        const contador = document.createElement('div');
        contador.className = 'col-span-full mb-1 text-xs font-medium text-ink-muted';
        contador.textContent = '0 seleccionadas de ' + letras.length;
        cbs.appendChild(contador);

        letras.forEach((letra) => {
          const label = document.createElement('label');
          label.className = 'cb-label flex items-center gap-1.5 text-sm cursor-pointer rounded-md border border-mist/60 bg-surface px-2 py-1 transition-colors hover:bg-mist/10 has-checked:border-stone has-checked:bg-stone/10';
          const checkbox = document.createElement('input');
          checkbox.type = 'checkbox';
          checkbox.value = letra;
          checkbox.className = 'cb-checkbox cursor-pointer';
          label.appendChild(checkbox);
          label.appendChild(document.createTextNode(letra));
          cbs.appendChild(label);
        });

        cbs.querySelectorAll('.cb-checkbox').forEach((cb) => {
          cb.addEventListener('change', () => {
            const seleccionadas = cbs.querySelectorAll('.cb-checkbox:checked').length;
            contador.textContent = seleccionadas + ' seleccionadas de ' + letras.length;
          });
        });
      }

      // ---- Configura la fila extra: selector + checkboxes por territorio ----
      function setupFilaExtra(row) {
        const select = row.querySelector('.territorio-select');
        select.addEventListener('change', () => {
          const numero = parseInt(select.value, 10);
          renderCuadrasFila(row, numero ? territoriosLetras[numero] : null);
        });
        row.querySelector('.remove-row').addEventListener('click', () => {
          row.remove();
          filasTerritorio--;
          reetiquetarFilas();
          actualizarBotones();
        });
      }

      // ---- Re-numera los encabezados de cada fila de territorio ----
      function reetiquetarFilas() {
        document.querySelectorAll('.row-label').forEach((el, idx) => {
          el.textContent = 'Territorio ' + (idx + 1);
        });
      }

      // ---- Muestra/oculta el botón "+ Agregar otro territorio" ----
      function actualizarBotones() {
        if (editandoId) {
          addTerritorioBtn.style.display = 'none';
          return;
        }
        addTerritorioBtn.style.display = filasTerritorio >= 3 ? 'none' : 'inline-block';
      }

      // ---- Recopila los datos de las filas del form y valida el máximo de 3 ----
      function recolectarDatos() {
        const territorios = [];
        const rows = document.querySelectorAll('.territorio-row');
        rows.forEach((row) => {
          const select = row.querySelector('.territorio-select');
          const checks = row.querySelectorAll('.cb-checkbox:checked');
          if (!select.value || checks.length === 0) return;
          territorios.push({
            territorio_id: parseInt(select.value, 10),
            cuadras: ordenarUnicas(Array.from(checks, (cb) => cb.value)),
          });
        });

        const checkPrincipal = cuadrasCheckboxes.querySelectorAll('.cb-checkbox:checked');
        const principal = parseInt(territorioSelect.value, 10);
        if (principal && checkPrincipal.length > 0) {
          territorios.unshift({
            territorio_id: principal,
            cuadras: ordenarUnicas(Array.from(checkPrincipal, (cb) => cb.value)),
          });
        }

        if (territorios.length === 0) {
          setFormMessage('Selecciona al menos un territorio y sus cuadras.', 'error');
          return null;
        }
        if (territorios.length > 3) {
          setFormMessage('Máximo 3 territorios por persona y día.', 'error');
          return null;
        }
        return territorios;
      }

      // ---- Envía la visita (o varias) al servidor ----
      async function enviarVisita(e) {
        e.preventDefault();
        const territorios = recolectarDatos();
        if (!territorios) return;

        const fecha = fechaInput.value;
        const persona = personaInput.value.trim();
        const turno = turnoInput.value;
        const cantidad_personas = cantidadInput.value ? parseInt(cantidadInput.value, 10) : null;

        if (!fecha) {
          setFormMessage('Debes indicar la fecha.', 'error');
          return;
        }
        if (!persona) {
          setFormMessage('Debes indicar la persona.', 'error');
          return;
        }
        if (!turno) {
          setFormMessage('Debes indicar el turno (Mañana o Tarde).', 'error');
          return;
        }

        try {
          const res = editandoId
            ? await fetch('/api/visitas', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: editandoId, fecha, persona, turno, cantidad_personas, territorios }),
              })
            : await fetch('/api/visitas', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fecha, persona, turno, cantidad_personas, territorios }),
              });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Error al guardar la visita');

          const cantidad = territorios.length;
          setFormMessage(
            (editandoId ? 'Visita actualizada' : 'Visita' + (cantidad > 1 ? 's' : '') + ' guardada' + (cantidad > 1 ? 's' : '') + ' correctamente') + ' (' + cantidad + ' territorio' + (cantidad > 1 ? 's' : '') + ').',
            'success'
          );

          cancelarEdicion();
          await cargarVisitas();
        } catch (err) {
          setFormMessage(err.message, 'error');
        }
      }

      // ---- Carga una visita en el formulario para editarla ----
      function editarVisita(btn) {
        editandoId = Number(btn.dataset.id);
        fechaInput.value = btn.dataset.fecha;
        personaInput.value = btn.dataset.persona;
        turnoInput.value = btn.dataset.turno || '';
        cantidadInput.value = btn.dataset.cantidad || '';
        territorioSelect.value = btn.dataset.territorio;

        document.querySelectorAll('.territorio-row').forEach((row) => row.remove());
        filasTerritorio = 1;

        renderCuadras();
        const cuadras = JSON.parse(btn.dataset.cuadras);
        cuadrasCheckboxes.querySelectorAll('.cb-checkbox').forEach((cb) => {
          cb.checked = cuadras.includes(cb.value);
        });
        const contador = document.getElementById('contadorSeleccion');
        if (contador) {
          const total = territoriosLetras[Number(btn.dataset.territorio)].length;
          contador.textContent = cuadrasCheckboxes.querySelectorAll('.cb-checkbox:checked').length + ' seleccionadas de ' + total;
        }

        submitBtn.textContent = 'Actualizar visita';
        cancelEditBtn.classList.remove('hidden');
        actualizarBotones();
        setFormMessage('Editando visita. Cambia los datos y pulsa "Actualizar visita".', 'success');
        form.scrollIntoView({ behavior: 'smooth' });
      }

      // ---- Sale del modo edición y limpia el formulario ----
      function cancelarEdicion() {
        editandoId = null;
        submitBtn.textContent = 'Guardar visita';
        cancelEditBtn.classList.add('hidden');
        form.reset();
        document.querySelectorAll('.territorio-row').forEach((row) => row.remove());
        filasTerritorio = 1;
        renderCuadras();
        actualizarBotones();
      }

      // ---- Elimina un registro de visita tras confirmar ----
      async function eliminarVisita(id) {
        if (!confirm('¿Eliminar este registro de visita?')) return;
        try {
          const res = await fetch('/api/visitas', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Error al eliminar la visita');
          await cargarVisitas();
        } catch (err) {
          setFormMessage(err.message, 'error');
        }
      }

      // ---- Asignaciones: referencias ----
      const tablaAsignaciones = document.getElementById('tablaAsignaciones');
      const mesInicioInput = document.getElementById('mesInicio');
      const mesFinInput = document.getElementById('mesFin');
      const soloSinSalida = document.getElementById('soloSinSalida');
      const resumenControl = document.getElementById('resumenControl');
      const controlContainer = document.getElementById('controlContainer');

      // ---- Utilidades de meses (formato YYYY-MM) ----
      function pad2(n) { return String(n).padStart(2, '0'); }
      function mesISO(fecha) { return fecha.getFullYear() + '-' + pad2(fecha.getMonth() + 1); }
      function sumarMeses(iso, n) {
        const [y, m] = iso.split('-').map(Number);
        return mesISO(new Date(y, m - 1 + n, 1));
      }
      function listaMeses(inicio, fin) {
        const meses = [];
        let cur = inicio;
        while (cur <= fin && meses.length < 24) { meses.push(cur); cur = sumarMeses(cur, 1); }
        return meses;
      }
      function primerDiaMes(iso) { return iso + '-01'; }
      function ultimoDiaMes(iso) {
        const [y, m] = iso.split('-').map(Number);
        return y + '-' + pad2(m) + '-' + pad2(new Date(y, m, 0).getDate());
      }
      function nombreMes(iso) {
        const nombres = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
        return nombres[Number(iso.split('-')[1]) - 1] + ' ' + iso.split('-')[0];
      }

      // ---- Construye la tabla de asignaciones a partir de las visitas ----
      // Cada territorio se divide en "rondas" de trabajo: una ronda termina cuando las
      // cuadras acumuladas cubren todo el territorio. Dentro de cada ronda, cada persona
      // ocupa un bloque "Asignado a" (colspan 2): nombre en la fila 1 y [Inicio | Fin] en
      // la fila 2. La fecha "se completó" se repite cuando se completó el mismo día.
      function renderAsignaciones() {
        let inicio = mesInicioInput.value;
        let fin = mesFinInput.value;
        if (!inicio || !fin) return;
        if (inicio > fin) { const tmp = inicio; inicio = fin; fin = tmp; }

        const meses = listaMeses(inicio, fin);
        const desde = primerDiaMes(inicio);
        const hasta = ultimoDiaMes(fin);

        const celdaVacia = '<span class="text-ink-subtle">&mdash;</span>';

        // ---- Agrupa las visitas de un territorio en rondas de trabajo ----
        // Una ronda se cierra cuando las cuadras acumuladas (en orden cronológico desde
        // el inicio del rango) cubren todas las letras del territorio; la siguiente
        // visita inicia una ronda nueva. Dentro de cada ronda se generan bloques: uno
        // por persona que trabajó ese territorio en esa ronda.
        function bloquesDeTerritorio(enRango, letras) {
          const todas = new Set(letras);
          const rondas = [];
          let actual = [];
          const acum = new Set();

          for (const v of enRango) {
            actual.push(v);
            expandirCuadras(v.cuadras).forEach((l) => acum.add(l));
            const cubre = [...todas].every((l) => acum.has(l));
            if (cubre) {
              rondas.push(actual);
              actual = [];
              acum.clear();
            }
          }
          if (actual.length) rondas.push(actual);

          // Fecha en que la persona terminó su trabajo dentro de la ronda:
          // - Si la persona completó el territorio (cubrió todas las cuadras): esa fecha.
          // - Si no lo completó pero es el ÚLTIMO bloque de la ronda VIGENTE: la última
          //   fecha que trabajó (aunque le falten cuadras, muestra hasta cuándo trabajó).
          // - Si no lo completó y su ronda ya terminó (vino otro): guion.
          const bloques = [];
          rondas.forEach((ronda, idx) => {
            const porPersona = {};
            const orden = [];
            ronda.forEach((v) => {
              if (!porPersona[v.persona]) { porPersona[v.persona] = []; orden.push(v.persona); }
              porPersona[v.persona].push(v);
            });
            const ultimaRonda = idx === rondas.length - 1;

            orden.forEach((persona, pi) => {
              const visitasP = porPersona[persona];
              const inicio = visitasP[0].fecha;

              // Acumulado de SOLO esta persona dentro de la ronda.
              const pAcum = new Set();
              let completado = '';
              visitasP.forEach((v) => {
                expandirCuadras(v.cuadras).forEach((l) => pAcum.add(l));
                if ([...todas].every((l) => pAcum.has(l))) completado = v.fecha;
              });

              let fin = completado;
              if (!fin && ultimaRonda && pi === orden.length - 1) {
                // Bloque vigente (última persona de la ronda en curso): última fecha trabajada.
                fin = visitasP[visitasP.length - 1].fecha;
              }

              bloques.push({ persona, inicio, fin });
            });
          });
          return bloques;
        }

        const bloquesPorTerritorio = {};
        TERRITORIOS.forEach((t) => {
          const enRango = visitas
            .filter((v) => v.territorio_id === t.numero && v.fecha >= desde && v.fecha <= hasta)
            .sort((x, y) => x.fecha.localeCompare(y.fecha));
          bloquesPorTerritorio[t.numero] = bloquesDeTerritorio(enRango, t.letras);
        });
        const nBloques = Math.max(4, ...Object.values(bloquesPorTerritorio).map((b) => b.length));

        const filasHtml = TERRITORIOS.map((t) => {
          const todasLetras = new Set(t.letras);

          // Última vez que se completó ANTES del mes de inicio seleccionado.
          // Se recorren las visitas anteriores al mes de inicio en orden cronológico;
          // la última fecha en la que las cuadras acumuladas cubren todo el territorio.
          const todasLetrasT = [...todasLetras];
          const visitasPrevias = visitas
            .filter((v) => v.territorio_id === t.numero && v.fecha < desde)
            .sort((x, y) => x.fecha.localeCompare(y.fecha));
          let ultimaFechaCompletado = '';
          {
            const acum = new Set();
            visitasPrevias.forEach((v) => {
              expandirCuadras(v.cuadras).forEach((l) => acum.add(l));
              const cubre = todasLetrasT.every((l) => acum.has(l));
              if (cubre) ultimaFechaCompletado = v.fecha;
            });
          }

          const bloques = bloquesPorTerritorio[t.numero] || [];

          // Fila 1: nombres (colspan 2 cada bloque)
          const row1 = [];
          // Fila 2: fechas (2 celdas cada bloque)
          const row2 = [];

          for (let i = 0; i < nBloques; i++) {
            const bloque = bloques[i];
            const sep = i > 0 ? ' border-l-2 border-black' : '';

            if (!bloque) {
              row1.push(`<td colspan="2" class="border-b border-line px-2 py-1 text-center${sep}">${celdaVacia}</td>`);
              row2.push(`<td colspan="2" class="border-b border-line px-2 py-1 text-center${sep}">${celdaVacia}</td>`);
              continue;
            }

            const inicioFecha = formatearFecha(bloque.inicio);

            row1.push(`<td colspan="2" class="border-b border-line px-2 py-1 text-center font-medium text-sm${sep}">${bloque.persona}</td>`);
            row2.push(
              `<td class="border-b border-line px-2 py-1 text-xs text-center whitespace-nowrap${sep}">${inicioFecha}</td>` +
              `<td class="border-b border-line px-2 py-1 text-xs text-center whitespace-nowrap">${bloque.fin ? formatearFecha(bloque.fin) : celdaVacia}</td>`
            );
          }

          return `
            <tr>
              <td rowspan="2" class="border-b border-line px-2 py-1 font-semibold text-center text-slate-800 bg-gradient-to-r from-[#d7e5f0] to-[#b9d4e6]">${t.numero}</td>
              <td rowspan="2" class="border-b border-line px-2 py-1 text-xs text-center bg-surface-2">${ultimaFechaCompletado ? formatearFecha(ultimaFechaCompletado) : '30/05/2026'}</td>
              ${row1.join('')}
            </tr>
            <tr>${row2.join('')}</tr>`;
        }).join('');

        // Encabezados
        const enc1 = [];
        const enc2 = [];
        for (let i = 0; i < nBloques; i++) {
          const sep = i > 0 ? ' border-l-2 border-black' : '';
          enc1.push(`<th colspan="2" class="px-2 py-1 bg-stone text-white${sep}">Asignado a</th>`);
          enc2.push(
            `<th class="px-2 py-1 bg-stone text-white text-[11px] font-normal${sep}">Fecha que se asignó</th>` +
            `<th class="px-2 py-1 bg-stone text-white text-[11px] font-normal">Fecha que se completó</th>`
          );
        }

        tablaAsignaciones.innerHTML = `
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr>
                <th rowspan="2" class="px-2 py-2 bg-stone text-white min-w-[80px]">Número<br>de Territorio</th>
                <th rowspan="2" class="px-2 py-2 bg-stone text-white text-xs font-medium min-w-[100px]">Última fecha<br>completado</th>
                ${enc1.join('')}
              </tr>
              <tr>${enc2.join('')}</tr>
            </thead>
            <tbody>${filasHtml}</tbody>
          </table>`;
      }

      const DIAS_SEMANA = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

      function isoFecha(d) {
        return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate());
      }
      function nombreDiaSemana(iso) {
        return DIAS_SEMANA[new Date(iso + 'T00:00:00').getDay()];
      }

      // ---- Control de salidas: día por día, marcando días sin salida ----
      function renderControl() {
        if (!visitas.length) {
          controlContainer.innerHTML = '<p class="text-sm text-ink-muted">No hay visitas registradas.</p>';
          resumenControl.innerHTML = '';
          return;
        }

        const porFecha = {};
        const soloFaltan = soloSinSalida.checked;
        visitas.forEach((v) => {
          (porFecha[v.fecha] = porFecha[v.fecha] || []).push(v);
        });

        const fechasInfo = Object.keys(porFecha).sort();
        const inicio = new Date(fechasInfo[0] + 'T00:00:00');
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);

        const dias = [];
        for (let d = new Date(inicio); d <= hoy; d.setDate(d.getDate() + 1)) dias.push(isoFecha(d));
        dias.sort().reverse();

        let conSalida = 0;
        let sinSalida = 0;
        const conSalidaSet = new Set(Object.keys(porFecha));
        dias.forEach((iso) => { if (conSalidaSet.has(iso)) conSalida++; else sinSalida++; });

        resumenControl.innerHTML = `
          <span class="badge bg-stone text-white">Total de días: ${dias.length}</span>
          <span class="badge bg-green-100 text-green-800 ring-1 ring-green-300 dark:bg-green-500/15 dark:text-green-300 dark:ring-green-500/30">Días con salida: ${conSalida}</span>
          <span class="badge bg-amber-100 text-amber-800 ring-1 ring-amber-300 dark:bg-amber-500/15 dark:text-amber-300 dark:ring-amber-500/30">Días sin salida registrada: ${sinSalida}</span>`;

        const porMes = {};
        dias.forEach((iso) => {
          if (soloFaltan && conSalidaSet.has(iso)) return;
          const mes = iso.slice(0, 7);
          (porMes[mes] = porMes[mes] || []).push(iso);
        });

        const meses = Object.keys(porMes).sort().reverse();
        controlContainer.innerHTML = meses.map((mes) => {
          const filas = porMes[mes].map((iso) => {
            const salidas = porFecha[iso] || [];
            let fechaCelda = `
              <div class="font-semibold text-ink">${formatearFecha(iso)}</div>
              <div class="text-[10px] text-ink-muted">${nombreDiaSemana(iso)}</div>`;
            if (salidas.length === 0) {
              const esHoy = iso === isoFecha(hoy);
              return `
                <tr class="bg-amber-50 dark:bg-amber-500/10">
                  <td class="px-2 py-1.5 border-b border-line align-top">${fechaCelda}</td>
                  <td colspan="5" class="px-2 py-1.5 border-b border-line text-autumn italic text-xs dark:text-amber-300">
                    Sin salidas registradas${esHoy ? ' (hoy)' : ''} — posiblemente no anotaron
                  </td>
                </tr>`;
            }
            return salidas.map((s, i) => `
              <tr class="${i % 2 ? 'bg-surface' : 'bg-surface-2'}">
                ${i === 0 ? `<td class="px-2 py-1.5 border-b border-line align-top" rowspan="${salidas.length}">${fechaCelda}</td>` : ''}
                <td class="px-2 py-1.5 border-b border-line text-sm font-medium text-center whitespace-nowrap">T${s.territorio_id}</td>
                <td class="px-2 py-1.5 border-b border-line text-sm">${s.persona}</td>
                <td class="px-2 py-1.5 border-b border-line text-sm text-center whitespace-nowrap">${s.turno || '—'}</td>
                <td class="px-2 py-1.5 border-b border-line text-sm text-center whitespace-nowrap">${Number(s.cantidad_personas) || '—'}</td>
                <td class="px-2 py-1.5 border-b border-line text-sm">${expandirCuadras(s.cuadras).join(', ') || '—'}</td>
              </tr>`).join('');
          }).join('');
          return `
            <div class="overflow-hidden rounded-lg bg-surface shadow-sm ring-1 ring-line">
              <h3 class="bg-stone px-3 py-1.5 text-xs font-bold tracking-wide text-white uppercase">${nombreMes(mes)}</h3>
              <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                  <thead>
                    <tr>
                      <th class="px-2 py-1 text-[10px] uppercase text-ink-muted text-left bg-surface-3 border-b border-line">Día</th>
                      <th class="px-2 py-1 text-[10px] uppercase text-ink-muted text-center bg-surface-3 border-b border-line">Territorio</th>
                      <th class="px-2 py-1 text-[10px] uppercase text-ink-muted text-left bg-surface-3 border-b border-line">Persona</th>
                      <th class="px-2 py-1 text-[10px] uppercase text-ink-muted text-center bg-surface-3 border-b border-line">Turno</th>
                      <th class="px-2 py-1 text-[10px] uppercase text-ink-muted text-center bg-surface-3 border-b border-line">N° pers</th>
                      <th class="px-2 py-1 text-[10px] uppercase text-ink-muted text-left bg-surface-3 border-b border-line">Cuadras</th>
                    </tr>
                  </thead>
                  <tbody>${filas}</tbody>
                </table>
              </div>
            </div>`;
        }).join('');
      }

      // ---- Carga las visitas desde el servidor y actualiza la interfaz ----
      async function cargarVisitas() {
        try {
          const res = await fetch('/api/visitas');
          if (!res.ok) throw new Error('Error al cargar las visitas');
          visitas = await res.json();
          renderTabla();
          renderTerritorios();
          renderAsignaciones();
          renderControl();
        } catch (err) {
          statusMessage.textContent = err.message;
          statusMessage.classList.remove('text-green-700', 'dark:text-green-400');
          statusMessage.classList.add('text-autumn', 'dark:text-red-300');
        }
      }

      // ---- Construye la tabla de visitas agrupada por territorio ----
      function renderTabla() {
        const agrupado = {};
        TERRITORIOS.forEach((t) => { agrupado[t.numero] = []; });
        visitas.forEach((v) => {
          if (agrupado[v.territorio_id]) agrupado[v.territorio_id].push(v);
        });

        const filas = [];
        const noVisitados = [];
        let conteo = 0;

        TERRITORIOS.forEach((t, idx) => {
          const visitasTerr = agrupado[t.numero];
          if (visitasTerr.length === 0) noVisitados.push(t.numero);
          const grupo = idx % 2 === 0 ? 'grupoA' : 'grupoB';

          if (idx === 0) {
            filas.push(`
              <tr class="territorio-group ${grupo}">
                <td colspan="4" class="td-grupo px-2 py-1.5 border-b border-line bg-gradient-to-r from-[#cfe1ee] to-[#a9c8de] font-bold text-stone text-sm">
                  Grupo A — Territorios 1 a 29
                </td>
              </tr>
            `);
          } else if (idx === 29) {
            filas.push(`
              <tr class="territorio-group ${grupo}">
                <td colspan="4" class="td-grupo px-2 py-1.5 border-b border-line bg-gradient-to-r from-[#e8dbc3] to-[#d8c094] font-bold text-stone text-sm">
                  Grupo B — Territorios 30 a 58
                </td>
              </tr>
            `);
          }

          filas.push(`
            <tr class="territorio-row-tabla ${grupo}">
              <td class="td-terr px-2 py-1.5 border-b border-line font-semibold text-sm text-center text-slate-800 bg-gradient-to-r ${idx % 2 === 0 ? 'from-[#d7e5f0] to-[#b9d4e6]' : 'from-[#f0ead9] to-[#e3d7b8]'}">
                Territorio ${t.numero}
              </td>
              <td class="px-2 py-1.5 border-b border-line ${idx % 2 === 0 ? 'bg-surface' : 'bg-surface-2'} hover:bg-mist/15 transition-colors">
                <strong>${visitasTerr.length}</strong>
              </td>
              <td class="px-2 py-1.5 border-b border-line ${idx % 2 === 0 ? 'bg-surface' : 'bg-surface-2'} hover:bg-mist/15 transition-colors">
                ${visitasTerr.map((v) => {
                  const btns = `
                    <button class="btn-edit text-[11px] text-brand underline cursor-pointer border-none bg-transparent p-0 ml-1 hover:text-stone-dark dark:hover:text-white"
                      data-id="${v.id}" data-fecha="${v.fecha}" data-persona="${v.persona.replace(/"/g, '&quot;')}" data-territorio="${v.territorio_id}"
                      data-turno="${v.turno || ''}" data-cantidad="${v.cantidad_personas || ''}"
                      data-cuadras='${JSON.stringify(v.cuadras)}'>Editar</button>
                    <button class="btn-delete text-[11px] text-autumn underline cursor-pointer border-none bg-transparent p-0 ml-1"
                      data-id="${v.id}">Eliminar</button>`;
                  const detalle = `${v.persona} (${formatearFecha(v.fecha)})` +
                    (v.turno ? ` — ${v.turno}` : '') +
                    (v.cantidad_personas ? ` · ${v.cantidad_personas} pers.` : '');
                  return `${detalle} ${btns}`;
                }).join('<br/>') || '<span class="text-slate-400 italic">Sin visitas</span>'}
              </td>
              <td class="px-2 py-1.5 border-b border-line ${idx % 2 === 0 ? 'bg-surface' : 'bg-surface-2'} hover:bg-mist/15 transition-colors">
                ${visitasTerr.map((v) => (Array.isArray(v.cuadras) ? v.cuadras.join(', ') : v.cuadras)).join('<br/>') || '<span class="text-slate-400 italic">—</span>'}
              </td>
            </tr>
          `);
          conteo += visitasTerr.length;
        });

        tablaContainer.innerHTML = `
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr>
                <th class="px-2 py-2 text-left bg-stone text-white sticky top-0">Territorio</th>
                <th class="px-2 py-2 text-center bg-stone text-white sticky top-0">#</th>
                <th class="px-2 py-2 text-left bg-stone text-white sticky top-0">Persona y fecha</th>
                <th class="px-2 py-2 text-left bg-stone text-white sticky top-0">Cuadras</th>
              </tr>
            </thead>
            <tbody>
              ${filas.join('')}
            </tbody>
          </table>
        `;

        statusMessage.textContent =
          'Total de visitas registradas: ' + conteo + '. Territorios sin visitar: ' +
          (noVisitados.length > 0 ? noVisitados.join(', ') : 'ninguno');
        statusMessage.classList.remove('text-autumn', 'dark:text-red-300');
        statusMessage.classList.add('text-green-700', 'dark:text-green-400');
      }

      // ---- Renderiza los territorios pendientes como tablas compactas por grupo ----
      const GRUPOS_TERRITORIOS = [
        { nombre: 'Irpavi', desde: 1, hasta: 17 },
        { nombre: 'Boloni y Caliri', desde: 18, hasta: 28 },
        { nombre: 'Bella Vista', desde: 29, hasta: 45 },
        { nombre: 'Irpavi 2', desde: 46, hasta: 49 },
        { nombre: 'Alto Irpavi', desde: 50, hasta: 59 },
      ];

      function datosTerritorio(t) {
        const visitasTerr = visitas.filter((v) => v.territorio_id === t.numero);
        const cuadrasVisitadas = new Set();
        visitasTerr.forEach((v) => {
          expandirCuadras(v.cuadras).forEach((c) => cuadrasVisitadas.add(c));
        });
        const faltantes = t.letras.filter((letra) => !cuadrasVisitadas.has(letra));
        const ultima = visitasTerr.map((v) => v.fecha).sort((a, b) => b.localeCompare(a))[0];
        return { visitadas: cuadrasVisitadas.size, faltantes, ultima };
      }

      function renderTerritorios() {
        // Ordena: los que hace más tiempo que no se visitan al inicio, los recién visitados al final
        const lista = TERRITORIOS.map((t) => ({
          numero: t.numero,
          ultimaFecha: datosTerritorio(t).ultima,
        }));
        lista.sort((a, b) => {
          if (!a.ultimaFecha && !b.ultimaFecha) return a.numero - b.numero;
          if (!a.ultimaFecha) return -1;
          if (!b.ultimaFecha) return 1;
          return a.ultimaFecha.localeCompare(b.ultimaFecha);
        });

        territoriosList.innerHTML = GRUPOS_TERRITORIOS.map((g, gIdx) => {
          const enGrupo = lista.filter((t) => t.numero >= g.desde && t.numero <= g.hasta);
          const filas = enGrupo.map((t) => {
            const terr = TERRITORIOS.find((x) => x.numero === t.numero);
            const d = datosTerritorio(terr);
            const estado = d.ultima
              ? `<span class="text-ink-muted">${formatearFecha(d.ultima)} <span class="text-[10px] text-ink-muted">(${calcularDias(d.ultima)}d)</span></span>`
              : '<span class="text-[10px] font-semibold text-autumn uppercase dark:text-red-300">Nunca</span>';
            const completado = d.faltantes.length === 0;
            return `
              <tr class="${completado ? 'bg-green-50 dark:bg-green-500/10' : d.ultima ? '' : 'bg-amber-50 dark:bg-amber-500/10'}">
                <td class="px-1.5 py-0.5 border-b border-line font-semibold text-xs text-center">T${t.numero}</td>
                <td class="px-1.5 py-0.5 border-b border-line text-[11px] whitespace-nowrap">${estado}</td>
                <td class="px-1.5 py-0.5 border-b border-line text-[11px] text-center">${d.visitadas}/${terr.letras.length}</td>
                <td class="px-1.5 py-0.5 border-b border-line text-[10px] ${completado ? 'text-green-700 dark:text-green-400' : 'text-autumn dark:text-red-300'}">${completado ? 'Completo' : (d.faltantes.join(',') || '—')}</td>
              </tr>`;
          }).join('');

          return `
            <div class="grupo-territorios overflow-hidden rounded-lg bg-surface shadow-sm ring-1 ring-line">
              <h3 class="bg-stone px-2 py-1.5 text-xs font-bold tracking-wide text-white uppercase">
                G${gIdx + 1} — ${g.nombre} <span class="font-normal opacity-80">(${g.desde}–${g.hasta})</span>
              </h3>
              <table class="w-full border-collapse">
                <tbody>${filas}</tbody>
              </table>
            </div>`;
        }).join('');
      }

      // ---- Inicialización: eventos y carga de datos ----
      fechaInput.valueAsDate = new Date();
      renderCuadras();
      actualizarBotones();

      territorioSelect.addEventListener('change', renderCuadras);
      cancelEditBtn.addEventListener('click', cancelarEdicion);

      // Delegación de eventos para los botones de Editar/Eliminar de la tabla
      tablaContainer.addEventListener('click', (e) => {
        const editBtn = e.target.closest('.btn-edit');
        if (editBtn) {
          editarVisita(editBtn);
          return;
        }
        const delBtn = e.target.closest('.btn-delete');
        if (delBtn) eliminarVisita(delBtn.dataset.id);
      });

      // Asignaciones: al cambiar los meses se reconstruye la tabla
      mesInicioInput.addEventListener('change', renderAsignaciones);
      mesFinInput.addEventListener('change', renderAsignaciones);
      soloSinSalida.addEventListener('change', renderControl);

      addTerritorioBtn.addEventListener('click', () => {
        if (filasTerritorio >= 3) return;
        filasTerritorio++;
        const row = createTerritorioRow();
        form.insertBefore(row, addTerritorioBtn);
        setupFilaExtra(row);
        actualizarBotones();
      });

      // ---- Tema claro/oscuro: por defecto claro; recuerda la preferencia ----
      const themeBtn = document.getElementById('themeBtn');
      const iconMoon = document.getElementById('iconMoon');
      const iconSun = document.getElementById('iconSun');
      function aplicarTema(oscuro) {
        document.documentElement.classList.toggle('dark', oscuro);
        iconMoon.classList.toggle('hidden', oscuro);
        iconSun.classList.toggle('hidden', !oscuro);
      }
      themeBtn.addEventListener('click', () => {
        const oscuro = !document.documentElement.classList.contains('dark');
        try { localStorage.setItem('theme', oscuro ? 'dark' : 'light'); } catch (e) {}
        aplicarTema(oscuro);
      });
      aplicarTema(document.documentElement.classList.contains('dark'));

      form.addEventListener('submit', enviarVisita);
      mesFinInput.value = mesISO(new Date());
      mesInicioInput.value = sumarMeses(mesFinInput.value, -3);
      cargarVisitas();
    </script>
  </body>
</html>
