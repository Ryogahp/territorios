---
import AppHeader from '../components/AppHeader.astro';
import AsignacionesTab from '../components/tabs/AsignacionesTab.astro';
import ControlTab from '../components/tabs/ControlTab.astro';
import PendientesTab from '../components/tabs/PendientesTab.astro';
import ProgramarMesTab from '../components/tabs/ProgramarMesTab.astro';
import RegistroTab from '../components/tabs/RegistroTab.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Registro de Territorios">
  <div id="app" class="mx-auto max-w-[1200px] md:p-4">
    <AppHeader />

    <main class="flex flex-col gap-3 md:gap-6">
      <RegistroTab />
      <PendientesTab />
      <ControlTab />
      <ProgramarMesTab />
    </main>

    <AsignacionesTab />
  </div>

  <script>
    import '../client/shell';
    import '../client/tabs/registro';
    import '../client/tabs/pendientes';
    import '../client/tabs/asignaciones';
    import '../client/tabs/control';
    import '../client/tabs/programar-mes';
  </script>
</Layout>
