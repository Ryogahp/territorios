<section id="contentControl" data-tab-panel="control" class="tab-panel card hidden p-4 md:p-6">
  <h2 class="section-title">Control de salidas diarias</h2>
  <div class="mb-4">
    <label
      class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-surface-2 px-3 py-2 text-sm font-medium ring-1 ring-mist/50 transition hover:bg-surface-3"
    >
      <input type="checkbox" id="soloSinSalida" class="h-4 w-4 cursor-pointer accent-stone" />
      Mostrar solo días sin salida registrada
    </label>
  </div>
  <p id="controlMessage" class="mb-3 text-sm font-medium" aria-live="polite"></p>
  <div id="resumenControl" class="mb-3 flex flex-wrap gap-2"></div>
  <div id="controlContainer" class="flex flex-col gap-3"></div>
</section>
